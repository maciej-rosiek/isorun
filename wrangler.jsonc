{
  // isorun: the hosted page (https://isorun.maciej-rosiek.workers.dev). One Worker serves the
  // app's web build (native/web/build.sh writes the whole site into native/web/dist), the
  // gamedata and morgue proxies, the offline engine (isorun-engine, bound below), and the visit counts (VisitLog, a Durable Object;
  // /stats?key=<STATS_KEY> shows them). worker/README.md has the routes.
  //
  // Deployed by .github/workflows/isorun-cloudflare.yml from the repository root, after the web
  // build: `npx wrangler deploy` (the Worker is bundled from worker/index.ts by wrangler itself).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "isorun",
  "main": "worker/index.ts",
  "compatibility_date": "2025-04-01",
  "assets": {
    "directory": "native/web/dist",
    "binding": "ASSETS",
    // A path that is no file of the build reaches the Worker, which sends a page load home (/):
    // the app does not route on the path, and the page's relative paths need it at the root.
    // These paths reach the Worker first: the proxies and the visit counts (the asset layer
    // would answer them otherwise), the engine (the other Worker's, through the service binding
    // below) and /native/ (the web build's old place), which redirects to /.
    "run_worker_first": ["/gamedata-proxy/*", "/morgue-proxy/*", "/engine/*", "/api/visit", "/stats", "/native", "/native/*"]
  },
  // the offline engine's files are a Worker of their own (engine/wrangler.jsonc), deployed
  // before this one by the same workflow: /engine/* goes to it, and the page offers offline games
  // where its stable/engine.json answers
  "services": [{ "binding": "ENGINE", "service": "isorun-engine" }],
  "durable_objects": { "bindings": [{ "name": "VISITS", "class_name": "VisitLog" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VisitLog"] }],
  "observability": {
    "enabled": true
  }
}
