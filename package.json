{
  "name": "isorun",
  "private": true,
  "description": "Isorun: Dungeon Crawl Stone Soup drawn isometrically, for gamepad, keyboard, mouse and touch. The app is Rust (native/); this is the JavaScript beside it: the hosted page's Worker, the web build's engine bridge and the tools.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maciej-rosiek/isorun.git"
  },
  "bugs": "https://github.com/maciej-rosiek/isorun/issues",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "web": "native/web/build.sh",
    "web:test": "node native/web/test.mjs",
    "record": "node tools/record/record.mjs",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "opentype.js": "^2.0.0",
    "playwright-core": "1.64.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.129.0"
  }
}
