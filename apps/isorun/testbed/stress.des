# A large level for measuring the renderer (testbed/iso.ts with ?level=stress): a grid of rooms with
# pillars, pools of every liquid, statues, items and monsters. Written by a script; only the tiles of iso.des.
NAME: isorun_testbed_stress
TILE:  # = wall_brick_dark
FTILE: . = floor_grey_dirt
FTILE: w = dngn_deep_water
FTILE: s = dngn_shallow_water
FTILE: L = dngn_lava
FTILE: m = dngn_deep_water_murky
FTILE: b = dngn_toxic_bog
FTILE: * = dngn_starwater
FTILE: u = liquefaction
FTILE: z = floor_slime
FTILE: a = floor_slime_acidic
KFEAT: + = dngn_closed_door
KFEAT: ' = dngn_open_door
KFEAT: > = dngn_stone_stairs_down
KFEAT: 8 = dngn_granite_statue
KMONS: h = mons_human
KMONS: o = mons_orc
KMONS: O = mons_ogre
KMONS: j = mons_jackal
KMONS: g = mons_goblin
KMONS: k = mons_kobold
KMONS: K = mons_skeletal_warrior
KMONS: W = mons_wight
KMONS: N = mons_necromancer
KITEM: ! = potion_offset
KITEM: ? = scroll
KITEM: $ = gold05
EYE:   @ N
LIGHT: l
MAP
