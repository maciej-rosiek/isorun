{
  // isorun-engine: the offline engine's files (engine/dist, as build.sh lays it
  // out), served to the hosted page's /engine/* through its ENGINE service
  // binding (the root wrangler.jsonc), and at its own address
  // (https://isorun-engine.maciej-rosiek.workers.dev).
  //
  // A Worker of its own so the app's deploy never has to upload the engine.
  // Deployed by .github/workflows/isorun-cloudflare.yml before the site, with
  //   engine/build.sh stable && node engine/publish.mjs
  // not a bare `wrangler deploy`: publish.mjs stages the channels not built
  // here from the live Worker into .publish, since a deploy replaces every file.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "isorun-engine",
  "main": "worker/index.ts",
  "compatibility_date": "2025-04-01",
  "assets": {
    "directory": ".publish",
    "binding": "ASSETS",
    // a missing file is a 404, never a page: a channel that was not published
    // reads as absent (the page then offers no offline games)
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
