+// The webtiles socket as a message queue: the WebAssembly build's JS queue
+// (wasm/bridge.h), or the Windows build's pipes below.
+#if defined(__EMSCRIPTEN__) || defined(TARGET_OS_WINDOWS)
+# define WEBTILES_QUEUE
+#endif
+
+#ifdef TARGET_OS_WINDOWS
+// Windows has no Unix datagram sockets, so the host (the native app's
+// engine.rs) runs crawl on pipes: each control message is one line of JSON
+// on stdin, and each flush of output goes to stdout as the socket would
+// carry it (newline-terminated JSON lines). The queue is what wasm/bridge.h
+// is for the WebAssembly build, with the same names. The end of stdin is a
+// hangup, as a server's SIGHUP: the game saves and exits.
+#include <condition_variable>
+#include <deque>
+#include <mutex>
+#include <thread>
+#include <fcntl.h>
+#include <io.h>
+
+static std::mutex _pipe_lock;
+static std::condition_variable _pipe_cv;
+static std::deque<std::string> _pipe_queue;
+static bool _pipe_closed = false;
+
+static void _pipe_reader()
+{
+    std::string partial;
+    char buf[4096];
+    while (true)
+    {
+        int n = _read(0, buf, sizeof(buf));
+        if (n <= 0)
+            break;
+        partial.append(buf, n);
+        size_t nl;
+        while ((nl = partial.find('\n')) != std::string::npos)
+        {
+            std::string line = partial.substr(0, nl);
+            partial.erase(0, nl + 1);
+            if (!line.empty() && line.back() == '\r')
+                line.pop_back();
+            if (line.empty())
+                continue;
+            std::lock_guard<std::mutex> l(_pipe_lock);
+            _pipe_queue.push_back(line);
+            _pipe_cv.notify_all();
+        }
+    }
+    std::lock_guard<std::mutex> l(_pipe_lock);
+    _pipe_closed = true;
+    _pipe_cv.notify_all();
+}
+
+static void _pipe_start()
+{
+    _setmode(0, _O_BINARY);
+    _setmode(1, _O_BINARY);
+    std::thread(_pipe_reader).detach();
+}
+
+static void wasm_bridge_emit(const char *buf, int len)
+{
+    fwrite(buf, 1, len, stdout);
+    fflush(stdout);
+}
+
+static char *wasm_bridge_pop_message()
+{
+    std::lock_guard<std::mutex> l(_pipe_lock);
+    if (_pipe_queue.empty())
+        return nullptr;
+    std::string s = _pipe_queue.front();
+    _pipe_queue.pop_front();
+    return strdup(s.c_str());
+}
+
+static bool wasm_bridge_has_message()
+{
+    std::lock_guard<std::mutex> l(_pipe_lock);
+    return !_pipe_queue.empty();
+}
+
+// Waits for a message; once stdin is closed and drained, it is a hangup.
+static void wasm_bridge_await_message()
+{
+    std::unique_lock<std::mutex> l(_pipe_lock);
+    _pipe_cv.wait(l, [] { return !_pipe_queue.empty() || _pipe_closed; });
+    if (_pipe_queue.empty() && _pipe_closed && !crawl_state.seen_hups)
+        crawl_state.seen_hups++;
+}
+#endif // TARGET_OS_WINDOWS
+
